# Example environment variables for Minecraft Server Panel
# Copy to .env and fill in your actual values
# DO NOT commit .env — it will be added to .gitignore

# Minecraft version
MC_VERSION=1.20.1

# Fabric loader version
FABRIC_VERSION=0.19.2

# Java command
JAVA_CMD=java

# Memory allocation
MIN_MEMORY=2G
MAX_MEMORY=4G

# Network (Zerotier)
NETWORK_NAME=ZEE-MC
NETWORK_ID=your_network_id_here

# Server port
MC_PORT=25565

# RCON (Remote Console) configuration
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=your_strong_password_here
